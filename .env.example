# Copie para .env e personalize (nao publique o .env)
PORT=3000
NODE_ENV=development
SESSION_SECRET=SUBSTITUA-POR-UMA-CHAVE-LONGA-ALEATORIA-DE-32-CARACTERES
ADMIN_EMAIL=admin@biblioweb.local
ADMIN_PASSWORD=SubstituaPorSenhaForte!123
ADMIN_NAME=Administrador
# Opcional: URL do PostgreSQL de hospedagem. Sem ela, usa SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/biblioweb
# Se o banco PostgreSQL exige TLS, use DATABASE_SSL=true.
DATABASE_SSL=false
# Origens externas de front-end permitidas por CORS (separadas por virgula).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

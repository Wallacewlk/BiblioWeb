{
  "name": "biblioweb-semestre",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto semestral de Programacao Web Avancada - Biblioteca Web (MVC, DAO, API REST, sessao, CORS)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "front": "node scripts/frontend-server.js",
    "check": "node --check src/server.js && node --check public/app.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-session-sequelize": "^7.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "cypress@16.3.0": true
  },
  "devDependencies": {
    "cypress": "^16.3.0"
  }
}
